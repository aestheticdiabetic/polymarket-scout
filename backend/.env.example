# ---- Required ----
POLYGON_RPC_URL=https://polygon-mainnet.g.alchemy.com/v2/YOUR_KEY_HERE

# ---- Optional: Dune Analytics ----
DUNE_API_KEY=

# ---- Optional: Telegram alerts ----
# Create a bot via @BotFather, then get your chat ID from @userinfobot
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# ---- Scoring defaults (all overridable from the dashboard) ----
MIN_TRADES=20
MIN_WIN_RATE=0.55
MIN_ROI=0.10
MIN_MARKETS=3

EARLY_ENTRY_WEIGHT=0.35
WIN_RATE_WEIGHT=0.35
ROI_WEIGHT=0.20
CONSISTENCY_WEIGHT=0.10

# ---- Arb detection ----
ARB_MAX_HOLD_SECONDS=300

# ---- Rotation detection ----
ROTATION_SIMILARITY_THRESHOLD=0.70
ROTATION_LOOKBACK_DAYS=90

# ---- Scheduler ----
SCAN_INTERVAL_MINUTES=60
